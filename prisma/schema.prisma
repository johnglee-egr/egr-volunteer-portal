generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Volunteer {
  id               String                @id @default(cuid())
  name             String
  email            String?
  phone            String?
  role             String                @default("volunteer") // volunteer, team_lead
  pendingRole      String?               // role awaiting admin approval e.g. "team_lead"
  contactPref      String                @default("both") // both | email | sms
  isOver21         Boolean?              // SELF-declared only. null = not answered.
  // What a team captain asserted about this member on "Build Your Team".
  // Advisory only — never satisfies the 21+ gate on alcohol-service shifts,
  // since it is a third party's unverified claim about someone else.
  captainClaimsOver21 Boolean?
  // A2P 10DLC consent audit trail. Carriers can require proof of opt-in, so we
  // record whether consent was given, when, and the exact wording shown.
  smsConsent       Boolean               @default(false)
  smsConsentAt     DateTime?
  smsConsentText   String?
  smsOptOutAt      DateTime?             // set when the volunteer replies STOP
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  assignments      Assignment[]
  pairRequests     PairRequest[]         @relation("requester")
  pairTargets      PairRequest[]         @relation("partner")
  groupLeaderOf    VolunteerGroup[]      @relation("groupLeader")
  groupMemberships VolunteerGroupMember[]
  teamsLed         Team[]                @relation("teamLeader")
  teamMemberships  TeamMember[]
}

model Category {
  id              String   @id @default(cuid())
  name            String   @unique
  description     String?
  color           String?
  sortOrder       Int      @default(0)
  type            String   @default("throughout") // "one-time" or "throughout"
  stationCount    Int      @default(1)
  volsPerStation  Int      @default(1)
  requiresOver21  Boolean  @default(false)
  createdAt       DateTime @default(now())
  shifts          Shift[]
}

model Shift {
  id           String       @id @default(cuid())
  title        String
  description  String?
  date         DateTime
  startTime    String
  endTime      String
  capacity     Int          @default(1)
  stationNames String?
  categoryId   String
  category     Category     @relation(fields: [categoryId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assignments  Assignment[]
}

model Assignment {
  id              String    @id @default(cuid())
  volunteerId     String
  shiftId         String
  stationIndex    Int?
  status          String    @default("confirmed") // confirmed, cancelled
  assignedBy      String    @default("self") // self, admin, triage
  reminded24h     Boolean   @default(false)
  reminded2h      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  volunteer       Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  shift           Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, shiftId])
}

model PairRequest {
  id          String    @id @default(cuid())
  requesterId String
  partnerId   String
  shiftId     String?
  message     String?
  status      String    @default("pending") // pending, approved, denied
  createdAt   DateTime  @default(now())
  requester   Volunteer @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  partner     Volunteer @relation("partner", fields: [partnerId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(cuid())
  type        String   // email, sms
  recipient   String
  subject     String?
  message     String
  status      String   @default("pending") // pending, sent, failed
  sentAt      DateTime?
  createdAt   DateTime @default(now())
}

model VolunteerGroup {
  id        String                @id @default(cuid())
  name      String
  leaderId  String
  leader    Volunteer             @relation("groupLeader", fields: [leaderId], references: [id])
  status    String                @default("pending") // pending, approved, denied
  message   String?
  createdAt DateTime              @default(now())
  members   VolunteerGroupMember[]
}

model VolunteerGroupMember {
  id          String         @id @default(cuid())
  groupId     String
  volunteerId String
  group       VolunteerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  volunteer   Volunteer      @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([groupId, volunteerId])
}

model Team {
  id        String       @id @default(cuid())
  name      String
  leaderId  String
  leader    Volunteer    @relation("teamLeader", fields: [leaderId], references: [id])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  members   TeamMember[]
}

model TeamMember {
  id          String    @id @default(cuid())
  teamId      String
  volunteerId String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([teamId, volunteerId])
}

model NotificationTemplate {
  id         String                 @id @default(cuid())
  name       String
  subject    String?
  body       String
  channel    String                 @default("both") // email | sms | both
  isPrebuilt Boolean                @default(false)
  createdAt  DateTime               @default(now())
  schedules  NotificationSchedule[]
}

model NotificationSchedule {
  id            String               @id @default(cuid())
  name          String
  templateId    String
  template      NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  groupType     String               // all | category | timerange | role | team | unassigned
  groupValue    String?              // categoryId | "HH:MM-HH:MM" | role name | teamId
  relativeType  String?              // days_before_festival | day_of | fixed
  relativeValue Int?                 // e.g. 3 for "3 days before festival"
  relativeTime  String?              // "HH:MM" time of day to send
  sendAt        DateTime?            // absolute datetime (for fixed type)
  isAutomatic   Boolean              @default(false)
  status        String               @default("pending") // pending | sent | cancelled | failed
  lastRunAt     DateTime?
  createdAt     DateTime             @default(now())
}

model FestivalSettings {
  id            String   @id @default("main")
  festivalName  String   @default("EGR Harvest + Beer Festival")
  festivalDate  String?
  festivalTime  String?
  contactEmail  String?
  contactPhone  String?
  welcomeMessage String?
  updatedAt     DateTime @updatedAt
}
